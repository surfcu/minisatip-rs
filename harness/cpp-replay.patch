diff --git a/src/replay.cpp b/src/replay.cpp
new file mode 100644
index 0000000..f6150ad
--- /dev/null
+++ b/src/replay.cpp
@@ -0,0 +1,244 @@
+/*
+ * File-replay tuner for differential testing (minisatip-rs ms-harness).
+ * MINISATIP_REPLAY=<file.ts> adds MINISATIP_REPLAY_ADAPTERS (default 1)
+ * adapters that loop over the file; MINISATIP_REPLAY_BITRATE paces it.
+ */
+#include "adapter.h"
+#include "dvb.h"
+#include "minisatip.h"
+#include "utils.h"
+#include "utils/logging/logging.h"
+
+#include <atomic>
+#include <chrono>
+#include <errno.h>
+#include <fcntl.h>
+#include <mutex>
+#include <poll.h>
+#include <set>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <string>
+#include <thread>
+#include <unistd.h>
+
+#define DEFAULT_LOG LOG_ADAPTER
+
+namespace {
+
+struct ReplayState {
+    std::string path;
+    uint64_t bitrate = 0;
+    int wfd = -1;
+    std::thread thread;
+    std::atomic<bool> stop{false};
+    std::mutex mutex;
+    std::set<int> pids; // 8192 means all PIDs
+};
+
+ReplayState *replay[MAX_ADAPTERS];
+
+// Paces on the whole mux (like a real tuner) and blocks on the pipe, so no
+// packet is dropped; an idle gap restarts the pacing budget.
+void replay_loop(ReplayState *st) {
+    using clock = std::chrono::steady_clock;
+    FILE *f = fopen(st->path.c_str(), "rb");
+    if (!f) {
+        LOG("replay: cannot open %s: %s", st->path.c_str(), strerror(errno));
+        return;
+    }
+    unsigned char packet[188];
+    auto start = clock::now();
+    uint64_t bytes = 0;
+    while (!st->stop) {
+        if (fread(packet, 1, sizeof(packet), f) != sizeof(packet)) {
+            if (ftell(f) < (long)sizeof(packet)) {
+                std::this_thread::sleep_for(std::chrono::milliseconds(100));
+            }
+            rewind(f);
+            continue;
+        }
+        if (st->bitrate) {
+            bytes += sizeof(packet);
+            auto due = start + std::chrono::microseconds(bytes * 8 * 1000000 /
+                                                         st->bitrate);
+            auto now = clock::now();
+            if (now > due + std::chrono::milliseconds(200)) {
+                start = now;
+                bytes = 0;
+            } else if (due > now) {
+                std::this_thread::sleep_until(due);
+            }
+        }
+        int pid = ((packet[1] & 0x1f) << 8) | packet[2];
+        {
+            std::lock_guard<std::mutex> lock(st->mutex);
+            if (!st->pids.count(8192) && !st->pids.count(pid))
+                continue;
+        }
+        size_t written = 0;
+        while (written < sizeof(packet) && !st->stop) {
+            struct pollfd pfd = {st->wfd, POLLOUT, 0};
+            if (poll(&pfd, 1, 100) <= 0)
+                continue;
+            ssize_t rv = write(st->wfd, packet + written, sizeof(packet) - written);
+            if (rv > 0)
+                written += rv;
+            else if (rv < 0 && errno != EAGAIN && errno != EINTR)
+                break;
+        }
+    }
+    fclose(f);
+}
+
+int replay_open(adapter *ad) {
+    ReplayState *st = replay[ad->id];
+    int fds[2];
+    if (pipe2(fds, O_NONBLOCK)) {
+        LOG("replay: pipe failed: %s", strerror(errno));
+        return 1;
+    }
+    fcntl(fds[0], F_SETPIPE_SZ, 1024 * 1024);
+    ad->dvr = fds[0];
+    st->wfd = fds[1];
+    st->stop = false;
+    {
+        std::lock_guard<std::mutex> lock(st->mutex);
+        st->pids.clear();
+    }
+    ad->fe = 0;
+    ad->strength = 255;
+    ad->snr = 15;
+    ad->status = FE_HAS_LOCK;
+    st->thread = std::thread(replay_loop, st);
+    LOG("replay: adapter %d replays %s at %ju bit/s", ad->id,
+        st->path.c_str(), (uintmax_t)st->bitrate);
+    return 0;
+}
+
+int replay_close(adapter *ad) {
+    ReplayState *st = replay[ad->id];
+    st->stop = true;
+    if (st->thread.joinable())
+        st->thread.join();
+    if (st->wfd >= 0)
+        close(st->wfd);
+    st->wfd = -1;
+    return 0;
+}
+
+int replay_set_pid(adapter *ad, int pid) {
+    ReplayState *st = replay[ad->id];
+    std::lock_guard<std::mutex> lock(st->mutex);
+    st->pids.insert(pid);
+    return 1000 + pid;
+}
+
+int replay_del_filters(adapter *ad, int fd, int pid) {
+    ReplayState *st = replay[ad->id];
+    std::lock_guard<std::mutex> lock(st->mutex);
+    st->pids.erase(pid);
+    return 0;
+}
+
+int replay_tune(int aid, transponder *tp) { return 0; }
+
+fe_delivery_system_t replay_delsys(int aid, int fd, fe_delivery_system_t *sys) {
+    return SYS_UNDEFINED;
+}
+
+// minisatip-rs replay adapters carry no frontend name.
+std::string replay_name(int aid, int fd) { return ""; }
+
+} // namespace
+
+void find_replay_adapter(adapter **a) {
+    const char *path = getenv("MINISATIP_REPLAY");
+    if (!path || !path[0])
+        return;
+    const char *count_env = getenv("MINISATIP_REPLAY_ADAPTERS");
+    const char *rate_env = getenv("MINISATIP_REPLAY_BITRATE");
+    int count = count_env ? atoi(count_env) : 1;
+    if (count < 1)
+        count = 1;
+    // As in minisatip-rs, a replay replaces the DVB adapters; the DVB scan
+    // would also reset pa/fn to -1, so init_all_hw would skip the replay.
+    opts.disable_dvb = 1;
+    for (int i = 0; i < count && a_count < MAX_ADAPTERS; i++) {
+        int na = a_count;
+        if (!a[na])
+            a[na] = adapter_alloc();
+        if (!replay[na])
+            replay[na] = new ReplayState();
+        replay[na]->path = path;
+        replay[na]->bitrate = rate_env ? strtoull(rate_env, NULL, 10) : 0;
+        adapter *ad = a[na];
+        ad->pa = na;
+        ad->fn = 0;
+        ad->open = replay_open;
+        ad->set_pid = replay_set_pid;
+        ad->del_filters = replay_del_filters;
+        ad->commit = NULL;
+        ad->tune = replay_tune;
+        ad->delsys = replay_delsys;
+        ad->name = replay_name;
+        ad->post_init = NULL;
+        ad->close = replay_close;
+        ad->get_signal = NULL;
+        ad->type = ADAPTER_DVB;
+        for (int k = 0; k < MAX_DELSYS; k++)
+            ad->sys[k] = SYS_UNDEFINED;
+        // Same delivery systems as the minisatip-rs replay adapters.
+        ad->sys[0] = (fe_delivery_system_t)SYS_DVBS2;
+        ad->sys[1] = (fe_delivery_system_t)SYS_DVBS;
+        a_count = na + 1;
+    }
+    LOG("replay: %d adapter(s) for %s", a_count, path);
+}
+
+// MINISATIP_REPLAY_CA: a unix datagram socket to a fake CAM stands in for the
+// CA device of a replay adapter ("%d" = adapter id, else only adapter 0).
+static std::atomic<int> replay_ca_fds[MAX_ADAPTERS];
+
+int replay_is_adapter(adapter *ad) { return ad && ad->open == replay_open; }
+
+int replay_ca_open(adapter *ad) {
+    const char *tmpl = getenv("MINISATIP_REPLAY_CA");
+    if (!tmpl || !*tmpl || ad->id < 0 || ad->id >= MAX_ADAPTERS)
+        return -1;
+    struct sockaddr_un local, remote;
+    memset(&local, 0, sizeof(local));
+    memset(&remote, 0, sizeof(remote));
+    local.sun_family = remote.sun_family = AF_UNIX;
+    if (strstr(tmpl, "%d"))
+        snprintf(remote.sun_path, sizeof(remote.sun_path), tmpl, ad->id);
+    else if (ad->id == 0)
+        snprintf(remote.sun_path, sizeof(remote.sun_path), "%s", tmpl);
+    else
+        return -1;
+    // One client path per adapter; a reconnect rebinds it.
+    snprintf(local.sun_path, sizeof(local.sun_path), "%s.c%d", remote.sun_path,
+             ad->id);
+    int fd = socket(AF_UNIX, SOCK_DGRAM, 0);
+    if (fd < 0)
+        return -1;
+    unlink(local.sun_path);
+    if (bind(fd, (struct sockaddr *)&local, sizeof(local)) ||
+        connect(fd, (struct sockaddr *)&remote, sizeof(remote))) {
+        LOG("replay: CA socket %s: %s", remote.sun_path, strerror(errno));
+        close(fd);
+        return -1;
+    }
+    replay_ca_fds[ad->id] = fd;
+    return fd;
+}
+
+int replay_ca_is_fd(int fd) {
+    for (auto &f : replay_ca_fds)
+        if (fd > 0 && f == fd)
+            return 1;
+    return 0;
+}
